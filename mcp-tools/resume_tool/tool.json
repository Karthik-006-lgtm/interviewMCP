{
  "name": "resume_tool",
  "description": "Uploads a resume and returns extracted skills, strengths, weaknesses, and role recommendations.",
  "transport": "http",
  "baseUrl": "http://localhost:8080/api",
  "auth": "Bearer JWT",
  "actions": [
    {
      "name": "upload_resume",
      "method": "POST",
      "path": "/resumes",
      "contentType": "multipart/form-data",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Absolute or workspace-relative path to a PDF or DOCX resume."
          }
        },
        "required": ["file"]
      }
    },
    {
      "name": "get_latest_resume",
      "method": "GET",
      "path": "/resumes/latest"
    }
  ]
}
